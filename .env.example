# ==============================================================================
# CloudVTurb - Variáveis de Ambiente
# ==============================================================================

# Servidor e Ambiente
PORT=4000
NODE_ENV=production
JWT_SECRET=defina_aqui_uma_chave_jwt_secreta_longa_e_aleatoria_2026

# Domínios e Topologia (Opcional)
APP_NAME=CloudVTurb
BASE_DOMAIN=seudominio.com
PLAYER_DOMAIN=player.seudominio.com
DASH_DOMAIN=dash.seudominio.com
# APP_LOGO_URL=https://dash.seudominio.com/logo-120x120.png

# ==============================================================================
# Resend - Envio de E-mails (Código de 8 Dígitos no Cadastro e Reset Pass)
# ==============================================================================
# Crie sua chave de API em: https://resend.com/api-keys
RESEND_API_KEY=re_sua_chave_da_resend_aqui

# Remetente autenticado no Resend (Use onboarding@resend.dev para testes rápidos)
RESEND_FROM_EMAIL=CloudVTurb <onboarding@resend.dev>

# ==============================================================================
# Google Drive - Importação Direta de Vídeos (Google Picker API)
# ==============================================================================
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_API_KEY=sua_api_key_do_google_cloud_aqui

# ==============================================================================
# e2payments - Gateway de Pagamentos (M-Pesa e e-Mola)
# ==============================================================================
# Habilita o modo SaaS comercial com cobrança de planos (default: false para self-hosted)
CLOUD_HOSTED=false
BILLING_ENABLED=false

# Credenciais e2payments (Obtenha em: https://e2payments.explicador.co.mz)
E2PAYMENT_CLIENT_ID=
E2PAYMENT_SECRET=

# IDs das Carteiras e2payments
E2PAYMENT_MPESA_WALLET_ID=159318
E2PAYMENT_EMOLA_WALLET_ID=511376

# Fila de transcodificacao HLS (quantos videos o ffmpeg processa ao mesmo tempo)
HLS_CONCURRENCY=1

# Cloudflare (opcional): limpa o cache quando um video e excluido/bloqueado e
# quando o player.js muda (a cada deploy). Token com "Zone > Cache Purge > Purge".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Zona do dominio de midia, se for outro dominio (vazio = mesma zona)
CLOUDFLARE_MEDIA_ZONE_ID=

# ---------------------------------------------------------------------------
# Dominios de midia (opcional) - mesmo modelo da VTurb: cdn. / scripts. / images.
# Quem tem um dominio so pode deixar tudo vazio (usa o dominio do player).
# MEDIA_BASE_DOMAIN gera cdn.<dominio>, scripts.<dominio> e images.<dominio>.
# ---------------------------------------------------------------------------
MEDIA_BASE_DOMAIN=
# CDN_DOMAIN=cdn.seudominio-midia.com
# SCRIPTS_DOMAIN=scripts.seudominio-midia.com
# IMAGES_DOMAIN=images.seudominio-midia.com

# ---------------------------------------------------------------------------
# Armazenamento dos videos: local (disco da VPS) ou r2 (Cloudflare R2 / S3).
# Tambem pode ser configurado pelo painel: Configuracoes > Provedor de Armazenamento.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# URL publica do bucket (dominio personalizado do R2), ex.: https://cdn.seudominio-midia.com
# S3_PUBLIC_URL=
# S3_ENDPOINT=   (opcional: calculado pelo R2_ACCOUNT_ID; use para AWS S3/MinIO)

# Preset do ffmpeg: ultrafast | superfast | veryfast (padrao) | faster | fast | medium
FFMPEG_PRESET=veryfast
